{
  "name": "streamdeck-hp",
  "version": "2.6.1",
  "description": "Gatito: Stream Tool",
  "main": "main.js",
  "author": "StreamDeck HP",
  "updateRepo": "",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": { "qrcode": "^1.5.4", "ws": "^8.18.0" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.streamdeckhp.app",
    "productName": "Gatito Stream Tool",
    "files": ["main.js", "server.js", "vbsetup.js", "obs.js", "editor.html", "vpad.html", "audio.html", "build/icon.png", "assets/**/*", "mobile/www/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "gatito-stream-tool-v${version}.${ext}" }
  }
}
